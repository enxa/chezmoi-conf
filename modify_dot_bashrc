# chezmoi:modify-template
{{- $line := "[[ -r ~/.config/termux/commands.bash ]] && source ~/.config/termux/commands.bash" -}}
{{- $rc := .chezmoi.stdin -}}
{{- $rc -}}
{{- if not (has $line (splitList "\n" (replace "\r\n" "\n" $rc))) -}}
{{- if and $rc (not (hasSuffix "\n" $rc)) }}{{ "\n" }}{{ end -}}
{{- printf "%s\n" $line -}}
{{- end -}}
